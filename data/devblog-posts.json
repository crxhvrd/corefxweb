        "width": 3840,
        "height": 2160
      },
      {
        "url": "https://cdn.discordapp.com/attachments/1080896900926017686/1558345586816716880/3240220_20261010074624_1.png?ex=6aed60ec&is=6aec0f6c&hm=f0dee23f1b2def6f27cd820228249549710fc897789209d3f2982a5920579f40&",
        "contentType": "image/png",
        "width": 3840,
        "height": 2160
