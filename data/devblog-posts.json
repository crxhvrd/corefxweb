        "width": 3840,
        "height": 2160
      },
      {
        "url": "https://cdn.discordapp.com/attachments/1080896900926017686/1558345586816716880/3240220_20261010074624_1.png?ex=6aecb82c&is=6aeb66ac&hm=613c87c03824f97226d644dc598ec24772d4ae7687a03a006e37cfbf5d852efe&",
        "contentType": "image/png",
        "width": 3840,
        "height": 2160
